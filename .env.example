# StarRadar 环境变量示例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）

# GitHub Token（用于数据采集 + 加星/Fork 操作）
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token_here

# LLM API Key（用于中文摘要 / 趋势解读 / 查询扩展）
LLM_API_KEY=sk-your_llm_api_key_here

# LLM 模型（可选，默认 gpt-4o-mini；推荐 deepseek-v4-flash 性价比高）
LLM_MODEL=deepseek-v4-flash

# LLM Base URL（可选，模型名前缀自动推断；也可手动指定）
# LLM_BASE_URL=https://api.deepseek.com

# 调试模式（可选，默认 0）
# DEBUG=1
